# SHUDDHO Clinical Functional Nutrition Platform
# Environment Configuration Template

# Dual-Deployment Flag (Cloudflare Pages supplies CF_PAGES=1 automatically)
CF_PAGES=1

# Supabase Production Backend Configuration
# Project: shuddho-clinical
# Get these from your Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_your_publishable_or_anon_key

# Optional alias for standard anon key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Note: NEVER expose SUPABASE_SERVICE_ROLE_KEY in frontend or client-side files.
